# ── Machine-local overrides ─────────────────────────────────────
# Any file with a ".local." infix or ".local" suffix is a machine-local
# override — kept on disk, never committed.
**/*.local.*
**/*.local

# ── Local-only agent planning docs ──────────────────────────────
# Files prefixed "_local." are working notes/plans kept on disk for agents to
# read, but intentionally never committed. See AGENTS.md "Local-only planning docs".
**/_local.*

# ── Claude Code local config ────────────────────────────────────
# Machine-local Claude Code working files. Shared skills are tracked.
.claude/*
!.claude/skills/
