<Window x:Class="Domna.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Domna.App.Views"
        xmlns:vm="clr-namespace:Domna.UI.ViewModels;assembly=Domna.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Домна — тепловое состояние колошника"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        Width="1780" Height="1000" MinWidth="1500" MinHeight="820">

    <!-- Three columns: input on the left, the shape of the flow in the middle, the
         session's saved calculations on the right. The overlays sit above all three
         because both of them describe the screen as a whole. -->

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid>
                    <TextBlock Style="{StaticResource Text.AppTitle}" VerticalAlignment="Center" Text="Domna" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding OpenProtocolCommand}" Content="Протокол" />
                        <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0"
                                Command="{Binding SaveSnapshotCommand}" Content="Сохранить расчёт" />
                        <Button Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                Command="{Binding CalculateCommand}" Content="Рассчитать" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                    <views:ParametersPanel />
                </Border>

                <views:ResultsPanel Grid.Column="1" />

                <Border Grid.Column="2"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                    <views:HistoryPanel />
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="28,0">
                <TextBlock Style="{StaticResource Text.Mono}" VerticalAlignment="Center"
                           Text="{Binding StatusLine}" />
            </Border>
        </Grid>

        <views:CalculationErrorNotice
            Visibility="{Binding HasCalculationError, Converter={StaticResource BooleanToVisibility}}" />

        <views:ProtocolSheet
            Visibility="{Binding IsProtocolOpen, Converter={StaticResource BooleanToVisibility}}" />
    </Grid>
</Window>
