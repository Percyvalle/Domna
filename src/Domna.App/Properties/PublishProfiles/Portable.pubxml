<?xml version="1.0" encoding="utf-8"?>
<!-- Portable release: one self-contained .exe that runs on a machine with no .NET installed.
     Copy it to a flash drive, copy it off, double-click. Publish with:
       dotnet publish src/Domna.App -c Release /p:PublishProfile=Portable -->
<Project>

  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Build\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Self-contained: the operator's machine is not guaranteed to have the
         .NET 10 Desktop Runtime, and this app must not require an installer. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>

    <!-- Ship the executable alone: without this the referenced projects drop their
         .pdb and XML doc files next to it, which are of no use to an operator. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDocumentationFile>false</PublishDocumentationFile>

    <!-- NOT trimmed: WPF does not support IL trimming, and InvariantGlobalization
         stays off on purpose — a Russian operator's decimal comma depends on the
         real ICU data being present (AGENTS.md §1.5). -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
