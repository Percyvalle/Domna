<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- StaticResource cannot look sideways into a sibling merged dictionary, so
         the theme is a chain rather than a flat list: Palette, then this file, then
         Controls. Each dictionary carries what it references. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Every text style on the screen is declared here. A screen picks one; it
         never sets a font size, weight or brush of its own. -->

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.AppTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <!-- One line, always. All eleven parameters have to stand in the input column
         at once — the list is read as a whole, and an operator who scrolls to see
         the last two loses the shape of the charge program. A name too long for the
         column is trimmed and carries its full text on the tooltip, which is why
         every name leads with the part that tells it apart. -->
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}" />
    </Style>

    <Style x:Key="Text.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
    </Style>

    <!-- Mono: every number the operator scans down a column, plus the codes and
         stamps that must not reflow when a digit changes width. -->
    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
    </Style>

    <Style x:Key="Text.MonoStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextBody}" />
    </Style>

    <Style x:Key="Text.OptimizerChange" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Zone.Center}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Text.RatioLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Text.RatioValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextBright}" />
    </Style>

    <Style x:Key="Text.ZoneValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextBright}" />
    </Style>

    <Style x:Key="Text.TargetValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
    </Style>

    <!-- A delta is read for its direction first. Colour carries that, and the arrow
         in the text carries it again for anyone who cannot separate the two hues. -->
    <Style x:Key="Text.Delta" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Delta.Direction}" Value="Up">
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Delta.Direction}" Value="Down">
                <Setter Property="Foreground" Value="{StaticResource Brush.Zone.Periphery}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A delta on its own line keeps that line whether or not there is a baseline.
         Without the fixed height the furnace-top panel would grow the moment a
         calculation is saved, and the chart beside it would jump with it. -->
    <Style x:Key="Text.DeltaLine" TargetType="TextBlock" BasedOn="{StaticResource Text.Delta}">
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Paper styles: the protocol sheet is a printed document that happens to be
         shown on a dark screen, so it keeps its own ink-on-paper scale. -->
    <Style x:Key="Text.Paper" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
    </Style>

    <Style x:Key="Text.PaperTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Paper}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.PaperCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Paper}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}" />
    </Style>

    <Style x:Key="Text.PaperMono" TargetType="TextBlock" BasedOn="{StaticResource Text.Paper}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Text.PaperReading" TargetType="TextBlock" BasedOn="{StaticResource Text.PaperMono}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
