<UserControl x:Class="Domna.App.Views.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Domna.UI.ViewModels;assembly=Domna.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{StaticResource Brush.Column}">

    <UserControl.Resources>
        <!-- The whole card is the "load" affordance: a saved calculation is a thing
             to go back to, and the card is the thing that names it. Being a button
             rather than a click handler on a border also keeps it reachable from the
             keyboard. The baseline entry is the one every delta on the screen is read
             against, so it is the only card that carries the accent. -->
        <Style x:Key="Card.History" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="Загрузить этот расчёт в параметры" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{StaticResource Brush.Panel}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.TextFaint}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.TextDim}" />
                            </DataTrigger>
                            <!-- Last, so the baseline keeps its accent under the cursor. -->
                            <DataTrigger Binding="{Binding IsBaseline}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.AccentWash}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Text.StatusBadge" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Text" Value="{Binding StatusBadge}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBaseline}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBaseline}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="22,20,22,12">
            <TextBlock Style="{StaticResource Text.ColumnHeader}" VerticalAlignment="Center" Text="ИСТОРИЯ" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Chip}"
                        Command="{Binding ExportHistoryCommand}"
                        ToolTip="Сохранить всю историю одной таблицей (CSV для Excel)"
                        Content="В Excel" />
                <Button Style="{StaticResource Button.ChipDanger}" Margin="8,0,0,0"
                        Command="{Binding ClearHistoryCommand}" Content="Очистить" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="22,14">
            <TextBlock Style="{StaticResource Text.Mono}"
                       Foreground="{StaticResource Brush.TextFainter}"
                       LineHeight="19"
                       Text="{x:Static vm:MainViewModel.ModelQualityCaption}" />
        </Border>

        <ScrollViewer Style="{StaticResource Scroll.Column}" Padding="22,0,22,16">
            <Grid>
                <Border BorderBrush="{StaticResource Brush.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,40,0,0"
                        Padding="20,28"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BooleanToVisibility}}">
                    <Border.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <TextBlock FontSize="15" Foreground="{StaticResource Brush.TextDim}"
                                   Text="Нет сохранённых расчётов" />
                        <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="20"
                                   Foreground="{StaticResource Brush.TextFainter}"
                                   Text="Сохранённый расчёт становится базой: с ним сравниваются дельты и к нему возвращает оптимизатор. История живёт только до закрытия приложения." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryEntryViewModel}">
                            <Button Style="{StaticResource Card.History}" Command="{Binding LoadCommand}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource Text.MonoStrong}" Text="{Binding Label}" />
                                        <TextBlock Style="{StaticResource Text.StatusBadge}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Text.MonoStrong}"
                                                   Foreground="{StaticResource Brush.Zone.Center}"
                                                   Text="{Binding Center}" />
                                        <TextBlock Style="{StaticResource Text.MonoStrong}" Margin="14,0,0,0"
                                                   Foreground="{StaticResource Brush.Zone.OreRidge}"
                                                   Text="{Binding OreRidge}" />
                                        <TextBlock Style="{StaticResource Text.MonoStrong}" Margin="14,0,0,0"
                                                   Foreground="{StaticResource Brush.Zone.Periphery}"
                                                   Text="{Binding Periphery}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,8,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextFaint}"
                                               Text="{Binding OptimizerCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsOptimized, Converter={StaticResource BooleanToVisibility}}" />

                                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextFaint}"
                                               Text="{Binding MatrixDiff}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasMatrixDiff, Converter={StaticResource BooleanToVisibility}}" />

                                    <Grid Margin="0,12,0,0">
                                        <Button Style="{StaticResource Button.Chip}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding CompareCommand}"
                                                Content="{Binding CompareCaption}" />
                                        <Button Style="{StaticResource Button.ChipDanger}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Command="{Binding DeleteCommand}"
                                                Content="Удалить" />
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
