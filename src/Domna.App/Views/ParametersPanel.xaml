<UserControl x:Class="Domna.App.Views.ParametersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Domna.App.Converters"
             xmlns:vm="clr-namespace:Domna.UI.ViewModels;assembly=Domna.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{StaticResource Brush.Column}">

    <UserControl.Resources>
        <conv:ParameterValueConverter x:Key="ParameterValue" />

        <!-- The out-of-range cue lives on the styles, not on each field: a value that
             left the fitted region is stated the same way everywhere it appears. -->
        <Style x:Key="Input.NumericValidated" TargetType="TextBox" BasedOn="{StaticResource Input.Numeric}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Text.RangeCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextFainter}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Text.ParameterName" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Text" Value="{Binding DisplayName}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCalculated}" Value="True">
                    <Setter Property="Text" Value="{Binding ShortName}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ParameterRow" DataType="{x:Type vm:ParameterInputViewModel}">
            <Border Style="{StaticResource ParameterRow.Container}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource ParameterRow.LabelAndRange}">
                        <TextBlock Style="{StaticResource Text.ParameterName}"
                                   ToolTip="{Binding DisplayName}" />
                        <StackPanel Style="{StaticResource ParameterRow.Range}">
                            <TextBox Style="{StaticResource Input.BoundsEditable}">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource ParameterValue}"
                                                  UpdateSourceTrigger="LostFocus">
                                        <Binding Path="EffectiveMinimum" Mode="TwoWay" />
                                        <Binding Path="Range.Decimals" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                            <TextBlock Style="{StaticResource Text.RangeCaption}" Text=" – " />
                            <TextBox Style="{StaticResource Input.BoundsEditable}">
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource ParameterValue}"
                                                  UpdateSourceTrigger="LostFocus">
                                        <Binding Path="EffectiveMaximum" Mode="TwoWay" />
                                        <Binding Path="Range.Decimals" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                            <TextBlock Style="{StaticResource Text.Mono}" Margin="10,0,0,0"
                                       Foreground="{StaticResource Brush.TextFainter}"
                                       Text="{Binding Unit}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource Toggle.FreeParameter}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Visibility="{Binding CanOptimize, Converter={StaticResource BooleanToVisibility}}"
                              IsChecked="{Binding IsFree}" />

                    <TextBox Grid.Column="2"
                             Style="{StaticResource Input.NumericValidated}"
                             IsReadOnly="{Binding IsCalculated}"
                             ToolTip="{Binding CalculatedValueDetail}"
                             VerticalAlignment="Center">
                        <TextBox.Text>
                            <MultiBinding Converter="{StaticResource ParameterValue}"
                                          UpdateSourceTrigger="LostFocus">
                                <Binding Path="Value" Mode="TwoWay" />
                                <Binding Path="Range.Decimals" Mode="OneWay" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                               Style="{StaticResource Text.OptimizerChange}"
                               Text="{Binding OptimizerChange}"
                               ToolTip="{Binding OptimizerChangeDetail}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="24,18,24,10">
            <TextBlock Style="{StaticResource Text.ColumnHeader}" Text="ПАРАМЕТРЫ ПРОЦЕССА" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource Text.Mono}" Text="СВОБ." />
                <TextBlock Style="{StaticResource Text.Mono}" Width="104" Margin="12,0,0,0"
                           TextAlignment="Right" Text="ЗНАЧЕНИЕ" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Button Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Command="{Binding ResetCommand}"
                        Content="Сбросить" />
                <TextBlock Style="{StaticResource Text.Mono}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding FreeParametersCaption}" />
            </Grid>
        </Border>

        <ScrollViewer Style="{StaticResource Scroll.Column}" Padding="24,0,24,8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ProcessInputs}" ItemTemplate="{StaticResource ParameterRow}" />

                <Border Style="{StaticResource ChargeProgram.Section}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource ChargeProgram.SectionHeader}">
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Style="{StaticResource ChargeProgram.ShortcutButton}"
                                    Click="OpenChargeProgram"
                                    Content="Матрица загрузки" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.ColumnHeader}" Text="Зоны загрузки" />
                                <TextBlock Style="{StaticResource ChargeProgram.Status}" Text="{Binding ChargeProgramCaption}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding StationInputs}" ItemTemplate="{StaticResource ParameterRow}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
