<UserControl x:Class="Domna.App.Views.ProtocolSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Domna.App.Views"
             xmlns:vm="clr-namespace:Domna.UI.ViewModels;assembly=Domna.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{StaticResource Brush.Scrim}">

    <!-- The protocol is a printed document that happens to be shown on a dark
         screen. It keeps paper colours on purpose: what the operator signs and what
         the operator sees have to be the same sheet. The sheet itself lives in
         ProtocolDocument, so printing sends the document and not these buttons. -->

    <Border Width="760" MaxHeight="900"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource Brush.Paper}"
            CornerRadius="4">
        <DockPanel Margin="52,44">
            <Grid DockPanel.Dock="Bottom" Margin="0,26,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.PaperPrimary}" Click="OnPrint" Content="Печать" />
                    <Button Style="{StaticResource Button.PaperGhost}" Margin="10,0,0,0"
                            Click="OnSaveAsPdf" Content="Сохранить PDF" />
                </StackPanel>
                <Button Style="{StaticResource Button.PaperQuiet}" HorizontalAlignment="Right"
                        Command="{Binding CloseProtocolCommand}"
                        Content="Закрыть" />
            </Grid>

            <ScrollViewer Style="{StaticResource Scroll.Column}">
                <views:ProtocolDocument x:Name="Document" DataContext="{Binding Protocol}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
